@model Alumni.Domain.Entities.User
@{
    ViewData["Title"] = "Hesap Ayarları";
    ViewData["ActiveNav"] = "/settings";
    var isAdmin = string.Equals(Model.Role, "Admin", StringComparison.OrdinalIgnoreCase);
    var successMessage = TempData["SuccessMessage"]?.ToString();
    var errorMessage = TempData["ErrorMessage"]?.ToString();
    var passwordSuccess = TempData["PasswordSuccessMessage"]?.ToString();
    var passwordError = TempData["PasswordErrorMessage"]?.ToString();
}

@section Styles {
    <style>
        .settings-grid {
            display: grid;
            grid-template-columns: 1.25fr 0.75fr;
            gap: 24px;
            align-items: start;
        }

        .form-row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .password-wrap {
            position: relative;
        }

        .password-wrap .form-control {
            padding-right: 44px;
        }

        .password-toggle {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 6px;
            border-radius: var(--radius-sm);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .password-toggle:hover {
            color: var(--brand-navy);
            background-color: var(--bg-surface-subtle);
        }

        .match-feedback {
            font-size: 0.78rem;
            margin-top: 4px;
            min-height: 18px;
        }

        .match-ok { color: var(--status-success); font-weight: 500; }
        .match-err { color: var(--status-danger); font-weight: 500; }

        @@media (max-width: 960px) {
            .settings-grid { grid-template-columns: 1fr; }
        }

        @@media (max-width: 600px) {
            .form-row-2 { grid-template-columns: 1fr; gap: 0; }
        }
    </style>
}

<section class="page-banner">
    <div class="container page-banner-inner">
        <div>
            <div class="eyebrow-badge">
                <span class="eyebrow-dot"></span>
                Hesap Yönetimi • Güvenlik
            </div>
            <h1 class="page-title">Hesap Ayarları</h1>
            <p class="page-subtitle">
                Kimlik bilgilerinizi güncelleyin, BCrypt korumalı şifrenizi değiştirin ve aktif oturum bilgilerinizi görüntüleyin.
            </p>
        </div>
        <div class="header-actions">
            <a href="/profile" class="btn btn-outline">← Profilime Dön</a>
        </div>
    </div>
</section>

<section class="page-content">
    <div class="container">
        <div class="settings-grid">
            <!-- Sol Sütun: Temel Hesap Bilgileri + Şifre Değiştirme -->
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <div class="card">
                    <div class="card-navy-header">
                        <h2>Temel Hesap Bilgileri</h2>
                        <span class="badge badge-gold">ID #@Model.Id</span>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(successMessage))
                        {
                            <div class="alert-success" role="status">@successMessage</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert-danger" role="alert">@errorMessage</div>
                        }

                        <form method="post" action="/settings/account">
                            <div class="form-row-2">
                                <div class="form-group">
                                    <label class="form-label" for="FirstName">Ad *</label>
                                    <input type="text"
                                           id="FirstName"
                                           name="FirstName"
                                           class="form-control"
                                           value="@Model.FirstName"
                                           maxlength="100"
                                           required />
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="LastName">Soyad *</label>
                                    <input type="text"
                                           id="LastName"
                                           name="LastName"
                                           class="form-control"
                                           value="@Model.LastName"
                                           maxlength="100"
                                           required />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="Email">E-posta Adresi *</label>
                                <input type="email"
                                       id="Email"
                                       name="Email"
                                       class="form-control"
                                       value="@Model.Email"
                                       maxlength="255"
                                       required />
                                <div class="form-hint">Bilgilerinizi kaydettiğinizde oturum kartınız (JWT) otomatik olarak yenilenir.</div>
                            </div>

                            <button type="submit" class="btn btn-navy">Hesap Bilgilerini Güncelle</button>
                        </form>
                    </div>
                </div>

                <!-- Şifre Değiştirme Kartı -->
                <div id="security" class="card" style="scroll-margin-top: 90px;">
                    <div class="card-header">
                        <h3>Şifre Değiştir</h3>
                        <span class="badge badge-navy">BCrypt Salt + Hash</span>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(passwordSuccess))
                        {
                            <div class="alert-success" role="status">@passwordSuccess</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(passwordError))
                        {
                            <div class="alert-danger" role="alert">@passwordError</div>
                        }

                        <form method="post" action="/settings/password">
                            <div class="form-group">
                                <label class="form-label" for="CurrentPassword">Mevcut Şifre *</label>
                                <div class="password-wrap">
                                    <input type="password"
                                           id="CurrentPassword"
                                           name="CurrentPassword"
                                           class="form-control"
                                           placeholder="Mevcut şifreniz"
                                           autocomplete="current-password"
                                           required />
                                    <button type="button" class="password-toggle" data-target="CurrentPassword" aria-label="Mevcut şifreyi göster veya gizle">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <div class="form-row-2">
                                <div class="form-group">
                                    <label class="form-label" for="NewPassword">Yeni Şifre *</label>
                                    <div class="password-wrap">
                                        <input type="password"
                                               id="NewPassword"
                                               name="NewPassword"
                                               class="form-control"
                                               placeholder="En az 6 karakter"
                                               minlength="6"
                                               autocomplete="new-password"
                                               required />
                                        <button type="button" class="password-toggle" data-target="NewPassword" aria-label="Yeni şifreyi göster veya gizle">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </button>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="ConfirmNewPassword">Yeni Şifre Tekrar *</label>
                                    <div class="password-wrap">
                                        <input type="password"
                                               id="ConfirmNewPassword"
                                               name="ConfirmNewPassword"
                                               class="form-control"
                                               placeholder="Yeni şifrenizi tekrar girin"
                                               minlength="6"
                                               autocomplete="new-password"
                                               required />
                                        <button type="button" class="password-toggle" data-target="ConfirmNewPassword" aria-label="Yeni şifre tekrarını göster veya gizle">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </button>
                                    </div>
                                    <div id="newPasswordFeedback" class="match-feedback"></div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-gold">Şifreyi Güncelle</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Sağ Sütun: Oturum & Rol Özeti -->
            <aside class="card">
                <div class="card-header">
                    <h3>Oturum &amp; Yetki Özeti</h3>
                    <span class="badge @(isAdmin ? "badge-gold" : "badge-navy")">@Model.Role</span>
                </div>
                <div class="card-body">
                    <div class="detail-grid" style="grid-template-columns: 1fr; margin-bottom: 18px;">
                        <div class="detail-item">
                            <div class="detail-item-label">Sistem Rolü</div>
                            <div class="detail-item-value">@Model.Role</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-item-label">Hesap Oluşturma</div>
                            <div class="detail-item-value tabular-nums">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm") UTC</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-item-label">Oturum Durumu</div>
                            <div class="detail-item-value" style="color: var(--status-success);">Aktif (JWT HttpOnly Cookie)</div>
                        </div>
                    </div>

                    <div class="alert-warning" style="margin-bottom: 18px;">
                        <strong>Güvenlik Notu:</strong> Sistem rolünüz yalnızca bir <strong>Admin</strong> tarafından değiştirilebilir; hesap ayarlarından rol yükseltme yapılamaz.
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <a href="/profile" class="btn btn-outline btn-block">Mezun Profilime Git</a>
                        @if (isAdmin)
                        {
                            <a href="/admin" class="btn btn-navy btn-block">Admin Paneline Git</a>
                        }
                        <form method="post" action="/logout" style="margin: 0;">
                            <button type="submit" class="btn btn-danger-outline btn-block">Oturumu Kapat (Çıkış Yap)</button>
                        </form>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('.password-toggle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var targetId = btn.getAttribute('data-target');
                    var input = document.getElementById(targetId);
                    if (!input) return;
                    input.type = input.type === 'password' ? 'text' : 'password';
                });
            });

            var newPass = document.getElementById('NewPassword');
            var confirmPass = document.getElementById('ConfirmNewPassword');
            var feedback = document.getElementById('newPasswordFeedback');

            function updateMatch() {
                if (!confirmPass.value) {
                    feedback.textContent = '';
                    feedback.className = 'match-feedback';
                    return;
                }
                if (newPass.value === confirmPass.value) {
                    feedback.textContent = 'Yeni şifreler eşleşiyor.';
                    feedback.className = 'match-feedback match-ok';
                } else {
                    feedback.textContent = 'Yeni şifreler henüz eşleşmiyor.';
                    feedback.className = 'match-feedback match-err';
                }
            }

            if (newPass && confirmPass && feedback) {
                newPass.addEventListener('input', updateMatch);
                confirmPass.addEventListener('input', updateMatch);
            }
        })();
    </script>
}
