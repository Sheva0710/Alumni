@model List<Alumni.Domain.Entities.Application>
@{
    ViewData["Title"] = "İş Başvuruları";
    ViewData["ActiveNav"] = "/applications";

    var users = ViewBag.Users as List<Alumni.Domain.Entities.User> ?? new List<Alumni.Domain.Entities.User>();
    var jobs = ViewBag.Jobs as List<Alumni.Domain.Entities.JobPost> ?? new List<Alumni.Domain.Entities.JobPost>();
    var userMap = users.ToDictionary(u => u.Id, u => u);
    var jobMap = jobs.ToDictionary(j => j.Id, j => j);
}

@section Styles {
    <style>
        .status-inline-form {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            flex-wrap: nowrap;
        }
        .status-select {
            min-height: 32px;
            padding: 4px 10px;
            font-size: 0.8125rem;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-sm);
            background-color: var(--bg-surface);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
        }
        .status-select:focus {
            outline: none;
            border-color: var(--brand-navy);
            box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.14);
        }
    </style>
}

<section class="page-banner">
    <div class="container page-banner-inner">
        <div>
            <span class="eyebrow-badge">
                <span class="eyebrow-dot" aria-hidden="true"></span>
                Aday &amp; Süreç Takibi
            </span>
            <h1 class="page-title">İş Başvuruları</h1>
            <p class="page-subtitle">Mezunların iş ilanlarına yaptığı başvuruları inceleyin, değerlendirme aşamalarını güncelleyin veya yeni başvuru oluşturun.</p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <span class="badge badge-navy tabular-nums" style="padding:8px 14px; font-size:0.8125rem;">
                Toplam Başvuru: @Model.Count
            </span>
            <a href="/jobs" class="btn btn-outline">İş İlanlarına Dön</a>
        </div>
    </div>
</section>

<section class="page-content">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-danger">@TempData["ErrorMessage"]</div>
        }

        <div class="workspace-grid">
            <div class="card">
                <div class="card-header">
                    <h2>Tüm Başvurular</h2>
                    <span class="badge badge-gold tabular-nums">@Model.Count Kayıt</span>
                </div>
                <div class="card-body">
                    @if (Model.Count == 0)
                    {
                        <div class="empty-state">
                            <p style="margin:0;">Henüz sisteme kayıtlı bir başvuru bulunmamaktadır.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Başvuran Aday</th>
                                        <th>İş İlanı</th>
                                        <th>Mevcut Durum</th>
                                        <th>Durum Güncelle</th>
                                        <th>Tarih</th>
                                        <th>İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in Model)
                                    {
                                        var badgeClass = app.Status.ToLowerInvariant() switch
                                        {
                                            "accepted" => "badge-success",
                                            "rejected" => "badge-danger",
                                            "interview" or "reviewing" => "badge-warning",
                                            _ => "badge-navy"
                                        };

                                        userMap.TryGetValue(app.UserId, out var applicant);
                                        jobMap.TryGetValue(app.JobPostId, out var jobPost);

                                        <tr>
                                            <td class="mono tabular-nums"><strong>#@app.Id</strong></td>
                                            <td>
                                                <a href="/users/details/@app.UserId" style="color: var(--brand-navy); font-weight: 600; text-decoration: none;">
                                                    @(applicant != null ? $"{applicant.FirstName} {applicant.LastName}" : $"Kullanıcı #{app.UserId}")
                                                </a>
                                                <div class="mono tabular-nums" style="font-size:0.75rem; color:var(--text-muted);">ID #@app.UserId</div>
                                            </td>
                                            <td>
                                                <a href="/jobs/details/@app.JobPostId" style="color: var(--text-primary); font-weight: 600; text-decoration: none;">
                                                    @(jobPost != null ? jobPost.Title : $"İlan #{app.JobPostId}")
                                                </a>
                                                @if (jobPost != null)
                                                {
                                                    <div style="font-size:0.78rem; color:var(--text-muted);">@jobPost.Company</div>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @badgeClass">@app.Status</span>
                                            </td>
                                            <td>
                                                <form action="/applications/@app.Id/status" method="post" class="status-inline-form">
                                                    <select name="status" class="status-select" aria-label="Başvuru durumu">
                                                        <option value="Applied" selected="@(app.Status == "Applied")">Applied</option>
                                                        <option value="Reviewing" selected="@(app.Status == "Reviewing")">Reviewing</option>
                                                        <option value="Interview" selected="@(app.Status == "Interview")">Interview</option>
                                                        <option value="Accepted" selected="@(app.Status == "Accepted")">Accepted</option>
                                                        <option value="Rejected" selected="@(app.Status == "Rejected")">Rejected</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-navy btn-sm">Güncelle</button>
                                                </form>
                                            </td>
                                            <td class="tabular-nums" style="color: var(--text-secondary); white-space:nowrap;">
                                                @app.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                            </td>
                                            <td>
                                                <form action="/applications/delete/@app.Id" method="post" style="display:inline;" onsubmit="return confirm('Bu başvuruyu iptal etmek istediğinize emin misiniz?');">
                                                    <button type="submit" class="btn btn-danger-outline btn-sm">İptal Et</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <aside class="card">
                <div class="card-navy-header">
                    <h2>Doğrudan Başvuru Oluştur</h2>
                    <span class="badge badge-gold">Unique Pair</span>
                </div>
                <div class="card-body">
                    <form action="/applications/create" method="post">
                        <div class="form-group">
                            <label for="userId" class="form-label">Başvuran Kullanıcı *</label>
                            <select name="userId" id="userId" class="form-control" required>
                                <option value="">-- Kullanıcı Seçiniz --</option>
                                @foreach (var user in users)
                                {
                                    <option value="@user.Id">@user.FirstName @user.LastName (@user.Role - @user.Email)</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="jobPostId" class="form-label">Başvurulacak İş İlanı *</label>
                            <select name="jobPostId" id="jobPostId" class="form-control" required>
                                <option value="">-- İş İlanı Seçiniz --</option>
                                @foreach (var job in jobs)
                                {
                                    <option value="@job.Id">#@job.Id: @job.Title — @job.Company</option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-gold btn-block">Başvuruyu Kaydet</button>
                    </form>

                    <div class="alert-warning" style="margin-top:16px;">
                        Aynı aday aynı ilana yalnızca bir kez başvurabilir (<span class="mono">UNIQUE (user_id, job_post_id)</span>).
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>
