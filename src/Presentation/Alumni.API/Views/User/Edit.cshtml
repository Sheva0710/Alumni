@model Alumni.Domain.Entities.User
@{
    ViewData["Title"] = $"Kullanıcı Düzenle — {Model.FirstName} {Model.LastName}";
    ViewData["ActiveNav"] = "/users";
}

<section class="page-banner">
    <div class="container-narrow page-banner-inner">
        <div>
            <span class="eyebrow-badge">
                <span class="eyebrow-dot" aria-hidden="true"></span>
                Hesap Güncelleme
            </span>
            <h1 class="page-title">Kullanıcı Bilgilerini Düzenle</h1>
            <p class="page-subtitle">Kayıt ID <span class="mono tabular-nums">#@Model.Id</span> için ad, soyad, e-posta ve rol bilgilerini güncelleyin.</p>
        </div>
        <div style="display:flex; gap:10px;">
            <a href="/users/details/@Model.Id" class="btn btn-outline">Detayları Gör</a>
            <a href="/users" class="btn btn-outline">← Listeye Dön</a>
        </div>
    </div>
</section>

<section class="page-content">
    <div class="container-narrow">
        <article class="card">
            <div class="card-navy-header">
                <h2>@Model.FirstName @Model.LastName</h2>
                <span class="badge badge-gold mono tabular-nums">ID #@Model.Id</span>
            </div>
            <div class="card-body">
                <form method="post" action="/users/edit/@Model.Id">
                    <div class="form-group">
                        <label for="FirstName" class="form-label">Ad *</label>
                        <input type="text" id="FirstName" name="FirstName" class="form-control" value="@Model.FirstName" required />
                    </div>
                    <div class="form-group">
                        <label for="LastName" class="form-label">Soyad</label>
                        <input type="text" id="LastName" name="LastName" class="form-control" value="@Model.LastName" />
                    </div>
                    <div class="form-group">
                        <label for="Email" class="form-label">E-Posta *</label>
                        <input type="email" id="Email" name="Email" class="form-control" value="@Model.Email" required />
                    </div>
                    <div class="form-group">
                        <label for="Role" class="form-label">Rol</label>
                        <input type="text" id="Role" name="Role" class="form-control" value="@Model.Role" />
                    </div>
                    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:20px;">
                        <button type="submit" class="btn btn-gold">Değişiklikleri Kaydet</button>
                        <a href="/users" class="btn btn-outline">İptal</a>
                    </div>
                </form>
            </div>
        </article>
    </div>
</section>
