@model Alumni.Domain.Entities.User
@using Alumni.API.Common
@{
    var currentUserId = User.GetUserId();
    var isOwnProfile = currentUserId.HasValue && currentUserId.Value == Model.Id;
    var canEditProfile = User.IsAdminRole() || isOwnProfile;
    ViewData["Title"] = $"Kullanıcı Detayları — {Model.FirstName} {Model.LastName}";
    ViewData["ActiveNav"] = isOwnProfile && !User.IsAdminRole() ? $"/users/details/{Model.Id}" : "/users";
    var initials = $"{(string.IsNullOrWhiteSpace(Model.FirstName) ? "U" : Model.FirstName[0].ToString().ToUpper())}{(string.IsNullOrWhiteSpace(Model.LastName) ? "" : Model.LastName[0].ToString().ToUpper())}";
}

<section class="page-banner">
    <div class="container page-banner-inner">
        <div>
            <span class="eyebrow-badge">
                <span class="eyebrow-dot" aria-hidden="true"></span>
                Mezun Profili &amp; İlişkili İlanlar
            </span>
            <h1 class="page-title">@Model.FirstName @Model.LastName</h1>
            <p class="page-subtitle">Kullanıcı hesap bilgileri, mezuniyet detayları ve yayınladığı iş ilanları.</p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <a href="/users" class="btn btn-outline">← Mezunlara Dön</a>
            @if (canEditProfile)
            {
                <a href="/users/edit/@Model.Id" class="btn btn-navy">Profili Düzenle</a>
            }
            <a href="/jobs" class="btn btn-gold">Tüm İlanlar</a>
        </div>
    </div>
</section>

<section class="page-content">
    <div class="container" style="display:grid; gap:24px;">
        <article class="card">
            <div class="card-navy-header">
                <div style="display:flex; align-items:center; gap:14px;">
                    <div style="width:44px; height:44px; border-radius:50%; background:#FFFFFF; color:var(--brand-navy); border:2px solid var(--accent-gold); display:flex; align-items:center; justify-content:center; font-family:'Plus Jakarta Sans',sans-serif; font-weight:800;">
                        @initials
                    </div>
                    <div>
                        <h2 style="margin:0;">@Model.FirstName @Model.LastName</h2>
                        <div style="font-size:0.8125rem; color:#DBEAFE;">@Model.Email</div>
                    </div>
                </div>
                <div style="display:flex; gap:8px; align-items:center;">
                    <span class="badge badge-gold">@Model.Role</span>
                    <span class="badge mono tabular-nums" style="background:rgba(255,255,255,0.14); color:#FFFFFF;">ID #@Model.Id</span>
                </div>
            </div>
            <div class="card-body">
                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-item-label">Ad Soyad</div>
                        <div class="detail-item-value">@Model.FirstName @Model.LastName</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item-label">E-Posta Adresi</div>
                        <div class="detail-item-value">@Model.Email</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item-label">Sistem Rolü</div>
                        <div class="detail-item-value"><span class="badge badge-navy">@Model.Role</span></div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item-label">Kayıt Tarihi</div>
                        <div class="detail-item-value tabular-nums">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</div>
                    </div>
                    @if (Model.Profile != null)
                    {
                        <div class="detail-item">
                            <div class="detail-item-label">Bölüm &amp; Mezuniyet Yılı</div>
                            <div class="detail-item-value tabular-nums">@Model.Profile.Department (@Model.Profile.GraduationYear)</div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Profile.CurrentCompany))
                        {
                            <div class="detail-item">
                                <div class="detail-item-label">Mevcut Şirket &amp; Unvan</div>
                                <div class="detail-item-value">@Model.Profile.CurrentCompany — @Model.Profile.CurrentTitle</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </article>

        <!-- HAFTA 06 MADDE 8: A page for one user, with their postings -->
        <article class="card">
            <div class="card-header">
                <div>
                    <h2>Bu Kullanıcının Açtığı İş İlanları <span class="badge badge-navy tabular-nums" style="margin-left:6px;">@(Model.JobPosts?.Count ?? 0)</span></h2>
                </div>
                <a href="/jobs" class="btn btn-gold btn-sm">+ Yeni İlan Aç</a>
            </div>
            <div class="card-body">
                @if (Model.JobPosts == null || Model.JobPosts.Count == 0)
                {
                    <div class="empty-state">
                        <p style="margin:0;">Bu kullanıcının henüz yayınladığı bir iş ilanı bulunmamaktadır (<span class="mono">jobs: []</span>).</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>İlan ID</th>
                                    <th>Pozisyon / Başlık</th>
                                    <th>Firma</th>
                                    <th>Yayınlanma Tarihi</th>
                                    <th>İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in Model.JobPosts)
                                {
                                    <tr>
                                        <td class="mono tabular-nums"><strong>#@job.Id</strong></td>
                                        <td><strong>@job.Title</strong></td>
                                        <td><span class="badge badge-navy">@job.Company</span></td>
                                        <td class="tabular-nums" style="color: var(--text-secondary);">@job.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>
                                            <a href="/jobs/details/@job.Id" class="btn btn-outline btn-sm">Detay &amp; Başvuranlar</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="alert-warning" style="margin-top:20px;">
                    <strong>DATA_DESIGN.md Silme Kuralı (Restrict):</strong> Bu kullanıcının yayında olan iş ilanları mevcutsa, doğrudan silme işlemi engellenir ve <span class="mono">409 Conflict</span> yanıtı döner.
                </div>
            </div>
        </article>
    </div>
</section>
