@model Alumni.Domain.Entities.JobPost
@{
    ViewData["Title"] = $"İlan Detayı — {Model.Title}";
    ViewData["ActiveNav"] = "/jobs";
    var applicants = ViewBag.Applicants as List<Alumni.Application.DTOs.Applications.ApplicantDto> ?? new List<Alumni.Application.DTOs.Applications.ApplicantDto>();
}

<section class="page-banner">
    <div class="container page-banner-inner">
        <div>
            <span class="eyebrow-badge">
                <span class="eyebrow-dot" aria-hidden="true"></span>
                Pozisyon Detayı &amp; Adaylar
            </span>
            <h1 class="page-title">@Model.Title</h1>
            <p class="page-subtitle">@Model.Company @if (!string.IsNullOrWhiteSpace(Model.City)) { <text>• @Model.City</text> }</p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <a href="/jobs" class="btn btn-outline">← İlanlara Dön</a>
            <a href="/users/details/@Model.PostedByUserId" class="btn btn-navy">İlan Sahibi Profili</a>
        </div>
    </div>
</section>

<section class="page-content">
    <div class="container" style="display:grid; gap:24px;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-danger">@TempData["ErrorMessage"]</div>
        }

        <article class="card">
            <div class="card-navy-header">
                <div>
                    <h2 style="margin:0;">@Model.Title</h2>
                    <div style="font-size:0.8125rem; color:#DBEAFE;">@Model.Company</div>
                </div>
                <div style="display:flex; gap:8px; align-items:center;">
                    <span class="badge badge-gold">@Model.Company</span>
                    <span class="badge mono tabular-nums" style="background:rgba(255,255,255,0.14); color:#FFFFFF;">İlan #@Model.Id</span>
                </div>
            </div>
            <div class="card-body" style="display:grid; gap:20px;">
                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-item-label">İlan Sahibi</div>
                        <div class="detail-item-value">
                            <a href="/users/details/@Model.PostedByUserId" style="color: var(--brand-navy); text-decoration: none;">
                                Kullanıcı #@Model.PostedByUserId →
                            </a>
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item-label">Şehir / Konum</div>
                        <div class="detail-item-value">@(string.IsNullOrWhiteSpace(Model.City) ? "Belirtilmedi" : Model.City)</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item-label">Oluşturulma Tarihi</div>
                        <div class="detail-item-value tabular-nums">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item-label">Silme Davranışı</div>
                        <div class="detail-item-value"><span class="badge badge-success">Cascade Delete</span></div>
                    </div>
                </div>

                <div>
                    <h3 style="font-size:1rem; margin-bottom:8px;">İş Tanımı ve Detaylar</h3>
                    <div style="background:var(--bg-canvas); border:1px solid var(--border-subtle); border-radius:var(--radius-md); padding:16px; color:var(--text-secondary); white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Description) ? "Bu ilan için ek açıklama girilmemiştir." : Model.Description)</div>
                </div>
            </div>
        </article>

        <article class="card">
            <div class="card-header">
                <h2>Bu İlana Başvuru Yap</h2>
                <span class="badge badge-navy">Tekil Çift Kuralı</span>
            </div>
            <div class="card-body">
                <form action="/jobs/@Model.Id/apply" method="post" style="display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
                    <select name="userId" class="form-control" style="flex:1; min-width:260px;" required>
                        <option value="">-- Başvuran Kullanıcıyı Seçiniz --</option>
                        @if (ViewBag.Users != null)
                        {
                            foreach (var user in (List<Alumni.Domain.Entities.User>)ViewBag.Users)
                            {
                                <option value="@user.Id">@user.FirstName @user.LastName (@user.Email)</option>
                            }
                        }
                    </select>
                    <button type="submit" class="btn btn-gold">Başvurumu Gönder</button>
                </form>
                <div class="alert-warning" style="margin-top:16px;">
                    <strong>Tekil Çift Kuralı (Unique Pair):</strong> Bir kullanıcı aynı ilana yalnızca bir kez başvurabilir; mükerrer başvuruda <span class="mono">409 Conflict</span> uygulanır.
                </div>
            </div>
        </article>

        <article class="card">
            <div class="card-header">
                <h2>Başvuran Adaylar <span class="badge badge-navy tabular-nums" style="margin-left:6px;">@applicants.Count</span></h2>
                <a href="/applications" class="btn btn-outline btn-sm">Tüm Başvuruları Yönet</a>
            </div>
            <div class="card-body">
                @if (applicants.Count == 0)
                {
                    <div class="empty-state">
                        <p style="margin:0;">Henüz bu ilana başvuran bir aday bulunmamaktadır.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Başvuru ID</th>
                                    <th>Aday Adı Soyadı</th>
                                    <th>E-Posta</th>
                                    <th>Durum</th>
                                    <th>Başvuru Tarihi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in applicants)
                                {
                                    var statusBadge = app.Status.ToLowerInvariant() switch
                                    {
                                        "accepted" => "badge-success",
                                        "rejected" => "badge-danger",
                                        "interview" or "reviewing" => "badge-warning",
                                        _ => "badge-navy"
                                    };

                                    <tr>
                                        <td class="mono tabular-nums"><strong>#@app.ApplicationId</strong></td>
                                        <td>
                                            <a href="/users/details/@app.UserId" style="color: var(--brand-navy); font-weight: 600; text-decoration: none;">
                                                @app.FirstName @app.LastName
                                            </a>
                                        </td>
                                        <td style="color: var(--text-secondary);">@app.Email</td>
                                        <td><span class="badge @statusBadge">@app.Status</span></td>
                                        <td class="tabular-nums" style="color: var(--text-secondary);">@app.AppliedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </article>
    </div>
</section>
