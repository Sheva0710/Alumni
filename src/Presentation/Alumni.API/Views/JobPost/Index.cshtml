@model List<Alumni.Domain.Entities.JobPost>
@{
    ViewData["Title"] = "İş ve Staj İlanları";
    ViewData["ActiveNav"] = "/jobs";
}

<section class="page-banner">
    <div class="container page-banner-inner">
        <div>
            <span class="eyebrow-badge">
                <span class="eyebrow-dot" aria-hidden="true"></span>
                Kariyer Fırsatları
            </span>
            <h1 class="page-title">İş ve Staj İlanları</h1>
            <p class="page-subtitle">Mezunlarımız ve partner kurumlar tarafından paylaşılan açık pozisyonları inceleyin veya yeni ilan yayınlayın.</p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <span class="badge badge-navy tabular-nums" style="padding:8px 14px; font-size:0.8125rem;">
                Yayındaki İlan: @Model.Count
            </span>
            <a href="/applications" class="btn btn-outline">Başvuruları Yönet</a>
        </div>
    </div>
</section>

<section class="page-content">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-danger">@TempData["ErrorMessage"]</div>
        }

        <div class="workspace-grid">
            <div class="card">
                <div class="card-header">
                    <h2>Yayındaki İş İlanları</h2>
                    <span class="badge badge-gold tabular-nums">@Model.Count İlan</span>
                </div>
                <div class="card-body">
                    @if (Model.Count == 0)
                    {
                        <div class="empty-state">
                            <p style="margin:0;">Henüz sisteme eklenmiş bir iş ilanı bulunmamaktadır.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Pozisyon</th>
                                        <th>Şirket</th>
                                        <th>İlan Sahibi</th>
                                        <th>Yayınlanma</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var job in Model)
                                    {
                                        <tr>
                                            <td class="mono tabular-nums"><strong>#@job.Id</strong></td>
                                            <td>
                                                <a href="/jobs/details/@job.Id" style="color: var(--brand-navy); font-weight: 600; text-decoration: none;">
                                                    @job.Title
                                                </a>
                                                @if (!string.IsNullOrWhiteSpace(job.City))
                                                {
                                                    <div style="font-size:0.8rem; color:var(--text-muted);">@job.City</div>
                                                }
                                            </td>
                                            <td><span class="badge badge-navy">@job.Company</span></td>
                                            <td>
                                                <a href="/users/details/@job.PostedByUserId" class="mono tabular-nums" style="color: var(--text-secondary); text-decoration: underline;">
                                                    Kullanıcı #@job.PostedByUserId
                                                </a>
                                            </td>
                                            <td class="tabular-nums" style="color: var(--text-secondary);">@job.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <div class="row-actions">
                                                    <a href="/jobs/details/@job.Id" class="btn btn-outline btn-sm">Detay &amp; Başvur</a>
                                                    <form action="/jobs/delete/@job.Id" method="post" style="display:inline;" onsubmit="return confirm('Bu ilanı silmek istediğinize emin misiniz? Bağlı tüm başvurular da Cascade kuralı ile silinecektir.');">
                                                        <button type="submit" class="btn btn-danger-outline btn-sm">Sil</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <aside class="card">
                <div class="card-navy-header">
                    <h2>Yeni İş İlanı Yayınla</h2>
                    <span class="badge badge-gold">Hızlı İlan</span>
                </div>
                <div class="card-body">
                    <form action="/jobs/create" method="post">
                        <div class="form-group">
                            <label for="postedByUserId" class="form-label">İlan Sahibi *</label>
                            <select name="postedByUserId" id="postedByUserId" class="form-control" required>
                                <option value="">-- Kullanıcı Seçin --</option>
                                @if (ViewBag.Users != null)
                                {
                                    foreach (var user in (List<Alumni.Domain.Entities.User>)ViewBag.Users)
                                    {
                                        <option value="@user.Id">@user.FirstName @user.LastName (@user.Role - @user.Email)</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="company" class="form-label">Firma / Kurum Adı *</label>
                            <input type="text" id="company" name="company" class="form-control" placeholder="Örn: ASELSAN, TechCorp" required />
                        </div>

                        <div class="form-group">
                            <label for="title" class="form-label">İlan Başlığı / Pozisyon *</label>
                            <input type="text" id="title" name="title" class="form-control" maxlength="120" placeholder="Örn: Junior .NET Backend Developer" required />
                            <div class="form-hint">En fazla 120 karakter.</div>
                        </div>

                        <div class="form-group">
                            <label for="city" class="form-label">Şehir / Konum</label>
                            <input type="text" id="city" name="city" class="form-control" maxlength="100" placeholder="Örn: İstanbul, Ankara, Uzaktan" />
                        </div>

                        <div class="form-group">
                            <label for="description" class="form-label">İlan Açıklaması</label>
                            <textarea id="description" name="description" class="form-control" placeholder="Adaylarda aranan kriterler, yetenekler ve çalışma şartları..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-gold btn-block">İlanı Yayınla</button>
                    </form>
                </div>
            </aside>
        </div>
    </div>
</section>
