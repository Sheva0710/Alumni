@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Alumni Tracking System";
    var activeNav = ViewData["ActiveNav"]?.ToString() ?? "";
    string NavClass(string route) => string.Equals(activeNav, route, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle — Alumni Tracking System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-canvas: #F8FAFC;
            --bg-surface: #FFFFFF;
            --bg-surface-subtle: #F1F5F9;
            --brand-navy: #1E3A8A;
            --brand-navy-hover: #1E40AF;
            --brand-navy-deep: #172554;
            --brand-navy-tint: #EFF6FF;
            --accent-gold: #D97706;
            --accent-gold-hover: #B45309;
            --accent-gold-tint: #FEF3C7;
            --text-primary: #1E293B;
            --text-secondary: #475569;
            --text-muted: #64748B;
            --border-subtle: #E2E8F0;
            --border-strong: #CBD5E1;
            --status-success: #059669;
            --status-success-tint: #ECFDF5;
            --status-warning: #D97706;
            --status-warning-tint: #FFFBEB;
            --status-danger: #DC2626;
            --status-danger-tint: #FEF2F2;
            --shadow-sm: 0 1px 2px rgba(30, 41, 59, 0.04), 0 1px 3px rgba(30, 41, 59, 0.03);
            --shadow-md: 0 10px 25px -5px rgba(30, 58, 138, 0.08), 0 4px 10px -2px rgba(30, 41, 59, 0.04);
            --shadow-nav: 0 4px 16px rgba(15, 23, 42, 0.06);
            --radius-sm: 6px;
            --radius-md: 8px;
            --radius-lg: 12px;
            --radius-pill: 9999px;
        }

        *, *::before, *::after { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            font-size: 16px;
            line-height: 1.6;
            background-color: var(--bg-canvas);
            color: var(--text-primary);
            -webkit-font-smoothing: antialiased;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main { flex: 1; }

        h1, h2, h3, .font-display {
            font-family: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;
            color: var(--text-primary);
            margin: 0;
        }

        .tabular-nums { font-variant-numeric: tabular-nums; }
        .mono { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace; }

        a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
            outline: 2px solid var(--brand-navy);
            outline-offset: 2px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .container-narrow {
            max-width: 820px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Header / Navbar */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 50;
            height: 72px;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-subtle);
            box-shadow: var(--shadow-nav);
        }

        .header-inner {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--brand-navy);
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1.125rem;
            letter-spacing: -0.02em;
            flex-shrink: 0;
        }

        .brand-mark {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-md);
            background: var(--brand-navy);
            color: #FFFFFF;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: inset 0 -2px 0 rgba(217, 119, 6, 0.85);
        }

        .main-nav {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .nav-link {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.9375rem;
            font-weight: 500;
            padding: 8px 12px;
            border-radius: var(--radius-md);
            transition: color 160ms ease, background-color 160ms ease;
            white-space: nowrap;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--brand-navy);
            background-color: var(--brand-navy-tint);
        }

        .nav-link.active { font-weight: 600; }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        /* Page Banner */
        .page-banner {
            padding: 40px 0 32px;
            background:
                radial-gradient(ellipse 75% 60% at 85% 0%, rgba(30, 58, 138, 0.05), transparent 65%),
                var(--bg-canvas);
            border-bottom: 1px solid var(--border-subtle);
        }

        .page-banner-inner {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }

        .eyebrow-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 4px 12px;
            border-radius: var(--radius-pill);
            background-color: var(--brand-navy-tint);
            border: 1px solid #DBEAFE;
            color: var(--brand-navy);
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .eyebrow-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: var(--accent-gold);
        }

        .page-title {
            font-size: clamp(1.625rem, 3vw, 2rem);
            font-weight: 700;
            line-height: 1.2;
            letter-spacing: -0.025em;
            margin-bottom: 6px;
        }

        .page-subtitle {
            color: var(--text-secondary);
            font-size: 0.95rem;
            margin: 0;
            max-width: 640px;
        }

        .page-content {
            padding: 36px 0 64px;
        }

        /* Layout Grids */
        .workspace-grid {
            display: grid;
            grid-template-columns: 1.45fr 0.85fr;
            gap: 24px;
            align-items: start;
        }

        /* Cards */
        .card {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .card-navy-header {
            background-color: var(--brand-navy);
            color: #FFFFFF;
            padding: 16px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .card-navy-header h2, .card-navy-header h3 {
            color: #FFFFFF;
            font-size: 1.0625rem;
            font-weight: 700;
        }

        .card-header {
            padding: 18px 22px;
            border-bottom: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .card-header h2, .card-header h3 {
            font-size: 1.0625rem;
            font-weight: 700;
        }

        .card-body { padding: 22px; }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 40px;
            padding: 9px 16px;
            border-radius: var(--radius-md);
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
            font-weight: 600;
            line-height: 1.2;
            text-decoration: none;
            cursor: pointer;
            border: 1px solid transparent;
            transition: all 160ms ease;
            white-space: nowrap;
        }

        .btn-sm {
            min-height: 32px;
            padding: 6px 12px;
            font-size: 0.8125rem;
        }

        .btn-gold { background-color: var(--accent-gold); color: #FFFFFF; }
        .btn-gold:hover {
            background-color: var(--accent-gold-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(217, 119, 6, 0.24);
        }

        .btn-navy { background-color: var(--brand-navy); color: #FFFFFF; }
        .btn-navy:hover {
            background-color: var(--brand-navy-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(30, 58, 138, 0.2);
        }

        .btn-outline {
            background-color: var(--bg-surface);
            color: var(--text-primary);
            border-color: var(--border-strong);
        }
        .btn-outline:hover {
            background-color: var(--bg-canvas);
            border-color: var(--brand-navy);
            color: var(--brand-navy);
        }

        .btn-danger-outline {
            background-color: var(--bg-surface);
            color: var(--status-danger);
            border-color: #FECACA;
        }
        .btn-danger-outline:hover {
            background-color: var(--status-danger-tint);
            border-color: var(--status-danger);
        }

        .btn-block { width: 100%; }

        /* Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: var(--radius-pill);
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1.3;
        }

        .badge-navy { background-color: var(--brand-navy-tint); color: var(--brand-navy); border: 1px solid #DBEAFE; }
        .badge-gold { background-color: var(--accent-gold-tint); color: #92400E; }
        .badge-success { background-color: var(--status-success-tint); color: var(--status-success); border: 1px solid #A7F3D0; }
        .badge-warning { background-color: var(--status-warning-tint); color: #B45309; border: 1px solid #FDE68A; }
        .badge-danger { background-color: var(--status-danger-tint); color: var(--status-danger); border: 1px solid #FECACA; }
        .badge-neutral { background-color: var(--bg-surface-subtle); color: var(--text-secondary); border: 1px solid var(--border-subtle); }

        /* Tables */
        .table-wrap { overflow-x: auto; }

        table.data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.875rem;
        }

        table.data-table th {
            text-align: left;
            padding: 12px 16px;
            background-color: var(--bg-surface-subtle);
            color: var(--text-secondary);
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            border-bottom: 1px solid var(--border-subtle);
            white-space: nowrap;
        }

        table.data-table td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-subtle);
            color: var(--text-primary);
            vertical-align: middle;
        }

        table.data-table tbody tr:hover {
            background-color: var(--bg-canvas);
        }

        table.data-table tbody tr:last-child td {
            border-bottom: none;
        }

        .row-actions {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        /* Forms */
        .form-group { margin-bottom: 16px; }
        .form-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 6px;
        }
        .form-control {
            width: 100%;
            min-height: 42px;
            padding: 9px 12px;
            background-color: var(--bg-surface);
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-md);
            font-family: 'Inter', sans-serif;
            font-size: 0.9375rem;
            color: var(--text-primary);
            transition: border-color 160ms ease, box-shadow 160ms ease;
        }
        textarea.form-control { min-height: 110px; resize: vertical; }
        .form-control:focus {
            outline: none;
            border-color: var(--brand-navy);
            box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.14);
        }
        .form-hint {
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* Detail & Alerts */
        .detail-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
        }
        .detail-item {
            background-color: var(--bg-canvas);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 14px 16px;
        }
        .detail-item-label {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: var(--text-muted);
            margin-bottom: 4px;
        }
        .detail-item-value {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-primary);
            word-break: break-word;
        }

        .alert-warning {
            background-color: var(--status-warning-tint);
            border: 1px solid #FDE68A;
            border-left: 4px solid var(--accent-gold);
            border-radius: var(--radius-md);
            padding: 14px 16px;
            font-size: 0.875rem;
            color: #92400E;
        }

        .alert-success {
            background-color: var(--status-success-tint);
            border: 1px solid #A7F3D0;
            border-left: 4px solid var(--status-success);
            border-radius: var(--radius-md);
            padding: 14px 16px;
            font-size: 0.875rem;
            color: #065F46;
            font-weight: 500;
            margin-bottom: 20px;
        }

        .alert-danger {
            background-color: var(--status-danger-tint);
            border: 1px solid #FECACA;
            border-left: 4px solid var(--status-danger);
            border-radius: var(--radius-md);
            padding: 14px 16px;
            font-size: 0.875rem;
            color: #991B1B;
            font-weight: 500;
            margin-bottom: 20px;
        }

        .empty-state {
            padding: 40px 24px;
            text-align: center;
            color: var(--text-muted);
            border: 1px dashed var(--border-strong);
            border-radius: var(--radius-md);
            background-color: var(--bg-canvas);
        }

        /* Footer */
        .site-footer {
            background-color: var(--brand-navy-deep);
            color: #CBD5E1;
            padding: 36px 0;
            border-top: 3px solid var(--accent-gold);
            margin-top: auto;
        }

        .footer-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
            flex-wrap: wrap;
        }

        .footer-brand {
            color: #FFFFFF;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 4px;
        }

        .footer-note { font-size: 0.875rem; color: #94A3B8; }
        .footer-links { display: flex; flex-wrap: wrap; gap: 20px; }
        .footer-links a { color: #E2E8F0; text-decoration: none; font-size: 0.875rem; font-weight: 500; }
        .footer-links a:hover { color: #FCD34D; }

        @@media (max-width: 1023px) {
            .main-nav { display: none; }
            .workspace-grid { grid-template-columns: 1fr; }
        }

        @@media (max-width: 767px) {
            .page-banner { padding: 28px 0 24px; }
            .page-content { padding: 24px 0 44px; }
            .header-actions .btn-outline { display: none; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a href="/" class="brand">
                <span class="brand-mark" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                        <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                    </svg>
                </span>
                <span>Alumni Network</span>
            </a>

            <nav class="main-nav" aria-label="Ana Navigasyon">
                <a href="/" class="@NavClass("/")">Ana Sayfa</a>
                <a href="/users" class="@NavClass("/users")">Mezunlar</a>
                <a href="/jobs" class="@NavClass("/jobs")">İş İlanları</a>
                <a href="/applications" class="@NavClass("/applications")">Başvurular</a>
                <a href="/announcements" class="@NavClass("/announcements")">Duyurular</a>
                <a href="/about" class="@NavClass("/about")">Hakkında</a>
            </nav>

            <div class="header-actions">
                <a href="/api/swagger" class="btn btn-outline">API Docs</a>
                <a href="/jobs" class="btn btn-gold">Fırsatları Keşfet</a>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div>
                <div class="footer-brand">Alumni Tracking System</div>
                <div class="footer-note">Üniversite Kariyer Merkezi &amp; Mezunlar Ofisi • Akademik Lacivert &amp; Altın Tasarım Sistemi</div>
            </div>
            <nav class="footer-links" aria-label="Alt Menü">
                <a href="/about">Hakkında</a>
                <a href="/users">Mezunlar</a>
                <a href="/jobs">İş İlanları</a>
                <a href="/applications">Başvurular</a>
                <a href="/announcements">Duyurular</a>
                <a href="/api/swagger">Swagger / API</a>
            </nav>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
