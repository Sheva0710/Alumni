@{
    Layout = null;
    ViewData["Title"] = "404 - Sayfa Bulunamadı";
    var requestedPath = Context.Request.Query["path"].ToString();
    if (string.IsNullOrWhiteSpace(requestedPath))
    {
        requestedPath = Context.Request.Path;
    }
    var reason = Context.Request.Query["reason"].ToString();
    if (string.IsNullOrWhiteSpace(reason))
    {
        reason = "Aradığınız sayfa silinmiş, adı değiştirilmiş veya geçici olarak kullanım dışı kalmış olabilir.";
    }
}

@Html.Raw(Alumni.API.Common.StaticHtmlPages.GetNotFoundPageHtml(requestedPath, reason))
