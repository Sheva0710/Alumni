@model List<Alumni.Domain.Entities.Announcement>
@{
    ViewData["Title"] = "Duyurular & Etkinlikler";
    ViewData["ActiveNav"] = "/announcements";
    var activeCount = Model.Count(a => a.IsActive);
}

<section class="page-banner">
    <div class="container page-banner-inner">
        <div>
            <span class="eyebrow-badge">
                <span class="eyebrow-dot" aria-hidden="true"></span>
                Kariyer Merkezi &amp; Mezunlar Ofisi
            </span>
            <h1 class="page-title">Duyurular &amp; Etkinlikler</h1>
            <p class="page-subtitle">Mezun buluşmaları, kariyer zirveleri ve kurumsal bildirimleri yönetin veya yeni duyuru yayınlayın.</p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <span class="badge badge-navy tabular-nums" style="padding:8px 14px; font-size:0.8125rem;">
                Toplam: @Model.Count • Aktif: @activeCount
            </span>
            <a href="/jobs" class="btn btn-outline">İş İlanları</a>
        </div>
    </div>
</section>

<section class="page-content">
    <div class="container workspace-grid">
        <div class="card">
            <div class="card-header">
                <h2>Yayınlanan Duyurular</h2>
                <span class="badge badge-gold tabular-nums">@Model.Count Duyuru</span>
            </div>
            <div class="card-body">
                @if (Model.Count == 0)
                {
                    <div class="empty-state">
                        <p style="margin:0;">Henüz yayınlanmış bir duyuru bulunmamaktadır.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Başlık</th>
                                    <th>Yayınlayan</th>
                                    <th>Tarih</th>
                                    <th>Durum</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="mono tabular-nums"><strong>#@item.Id</strong></td>
                                        <td>
                                            <a href="/announcements/details/@item.Id" style="color: var(--brand-navy); font-weight: 600; text-decoration: none;">
                                                @item.Title
                                            </a>
                                        </td>
                                        <td style="color: var(--text-secondary);">@item.Author</td>
                                        <td class="tabular-nums" style="color: var(--text-secondary); white-space:nowrap;">
                                            @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                        </td>
                                        <td>
                                            <span class="badge @(item.IsActive ? "badge-success" : "badge-danger")">
                                                @(item.IsActive ? "Aktif" : "Pasif")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="row-actions">
                                                <a href="/announcements/details/@item.Id" class="btn btn-outline btn-sm">Detay</a>
                                                <a href="/announcements/edit/@item.Id" class="btn btn-outline btn-sm">Düzenle</a>
                                                <form action="/announcements/delete/@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Bu duyuruyu silmek istediğinize emin misiniz?');">
                                                    <button type="submit" class="btn btn-danger-outline btn-sm">Sil</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <aside class="card">
            <div class="card-navy-header">
                <h2>Yeni Duyuru Yayınla</h2>
                <span class="badge badge-gold">Duyuru</span>
            </div>
            <div class="card-body">
                <form method="post" action="/announcements">
                    <div class="form-group">
                        <label for="Title" class="form-label">Duyuru Başlığı *</label>
                        <input type="text" id="Title" name="Title" class="form-control" required placeholder="Örn: Kariyer Zirvesi 2026" />
                    </div>
                    <div class="form-group">
                        <label for="Content" class="form-label">Duyuru İçeriği *</label>
                        <textarea id="Content" name="Content" class="form-control" required placeholder="Duyuru detaylarını, tarih ve katılım bilgilerini buraya yazın..."></textarea>
                    </div>
                    <div class="form-group">
                        <label for="Author" class="form-label">Yayınlayan Birim / Kişi</label>
                        <input type="text" id="Author" name="Author" class="form-control" placeholder="Kariyer Merkezi" />
                        <div class="form-hint">Boş bırakılırsa varsayılan olarak <strong>Kariyer Merkezi</strong> atanır.</div>
                    </div>
                    <button type="submit" class="btn btn-gold btn-block">Duyuruyu Yayınla</button>
                </form>
            </div>
        </aside>
    </div>
</section>
