@model Alumni.Domain.Entities.Announcement
@{
    ViewData["Title"] = $"Duyuru Düzenle — {Model.Title}";
    ViewData["ActiveNav"] = "/announcements";
}

@section Styles {
    <style>
        .checkbox-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            background-color: var(--bg-canvas);
            cursor: pointer;
        }
        .checkbox-card input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: var(--brand-navy);
            cursor: pointer;
        }
    </style>
}

<section class="page-banner">
    <div class="container-narrow page-banner-inner">
        <div>
            <span class="eyebrow-badge">
                <span class="eyebrow-dot" aria-hidden="true"></span>
                Duyuru Güncelleme
            </span>
            <h1 class="page-title">Duyuru Bilgilerini Düzenle</h1>
            <p class="page-subtitle">Duyuru <span class="mono tabular-nums">#@Model.Id</span> içeriğini, yayınlayan bilgisini ve aktiflik durumunu güncelleyin.</p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <a href="/announcements/details/@Model.Id" class="btn btn-outline">Detayı Gör</a>
            <a href="/announcements" class="btn btn-outline">← Listeye Dön</a>
        </div>
    </div>
</section>

<section class="page-content">
    <div class="container-narrow">
        <article class="card">
            <div class="card-navy-header">
                <h2>@Model.Title</h2>
                <span class="badge badge-gold mono tabular-nums">ID #@Model.Id</span>
            </div>
            <div class="card-body">
                <form method="post" action="/announcements/edit/@Model.Id">
                    <div class="form-group">
                        <label for="Title" class="form-label">Duyuru Başlığı *</label>
                        <input type="text" id="Title" name="Title" class="form-control" value="@Model.Title" required />
                    </div>
                    <div class="form-group">
                        <label for="Content" class="form-label">Duyuru İçeriği *</label>
                        <textarea id="Content" name="Content" class="form-control" style="min-height:140px;" required>@Model.Content</textarea>
                    </div>
                    <div class="form-group">
                        <label for="Author" class="form-label">Yayınlayan</label>
                        <input type="text" id="Author" name="Author" class="form-control" value="@Model.Author" />
                    </div>
                    <div class="form-group">
                        <label for="IsActive" class="checkbox-card">
                            <input type="checkbox" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                            <span>
                                <strong style="display:block; font-size:0.9rem; color:var(--text-primary);">Aktif Yayın Durumu</strong>
                                <span style="font-size:0.8rem; color:var(--text-muted);">İşaretliyse duyuru platformda aktif olarak listelenir.</span>
                            </span>
                        </label>
                    </div>
                    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:20px;">
                        <button type="submit" class="btn btn-gold">Değişiklikleri Kaydet</button>
                        <a href="/announcements" class="btn btn-outline">İptal</a>
                    </div>
                </form>
            </div>
        </article>
    </div>
</section>
