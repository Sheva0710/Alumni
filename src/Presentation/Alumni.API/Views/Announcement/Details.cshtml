@model Alumni.Domain.Entities.Announcement
@{
    ViewData["Title"] = $"Duyuru Detayı — {Model.Title}";
    ViewData["ActiveNav"] = "/announcements";
}

<section class="page-banner">
    <div class="container-narrow page-banner-inner">
        <div>
            <span class="eyebrow-badge">
                <span class="eyebrow-dot" aria-hidden="true"></span>
                Kurumsal Duyuru
            </span>
            <h1 class="page-title">@Model.Title</h1>
            <p class="page-subtitle">@Model.Author tarafından yayınlandı • <span class="tabular-nums">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</span></p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <a href="/announcements" class="btn btn-outline">← Duyurulara Dön</a>
            <a href="/announcements/edit/@Model.Id" class="btn btn-navy">Düzenle</a>
        </div>
    </div>
</section>

<section class="page-content">
    <div class="container-narrow">
        <article class="card">
            <div class="card-navy-header">
                <h2 style="margin:0;">@Model.Title</h2>
                <div style="display:flex; gap:8px; align-items:center;">
                    <span class="badge @(Model.IsActive ? "badge-success" : "badge-danger")">
                        @(Model.IsActive ? "Aktif" : "Pasif")
                    </span>
                    <span class="badge mono tabular-nums" style="background:rgba(255,255,255,0.14); color:#FFFFFF;">ID #@Model.Id</span>
                </div>
            </div>
            <div class="card-body" style="display:grid; gap:20px;">
                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-item-label">Yayınlayan Birim / Kişi</div>
                        <div class="detail-item-value">@Model.Author</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item-label">Yayınlanma Tarihi</div>
                        <div class="detail-item-value tabular-nums">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</div>
                    </div>
                </div>

                <div>
                    <h3 style="font-size:1rem; margin-bottom:8px;">Duyuru Metni</h3>
                    <div style="background:var(--bg-canvas); border:1px solid var(--border-subtle); border-radius:var(--radius-md); padding:20px; color:var(--text-primary); white-space:pre-line; line-height:1.7;">@Model.Content</div>
                </div>

                <div style="display:flex; gap:10px; flex-wrap:wrap; padding-top:8px; border-top:1px solid var(--border-subtle);">
                    <a href="/announcements/edit/@Model.Id" class="btn btn-gold">Duyuruyu Düzenle</a>
                    <a href="/announcements" class="btn btn-outline">Duyuru Listesine Dön</a>
                </div>
            </div>
        </article>
    </div>
</section>
