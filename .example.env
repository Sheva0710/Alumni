# ==============================================================================
# Alumni Tracking System - Environment Variables Template
# Bu dosya bir şablondur (.example.env). Gerçek ortamda çalıştırmak için:
#   1. Bu dosyayı kopyalayarak '.env' adında yeni bir dosya oluşturun:
#      cp .example.env .env  (Linux/macOS) veya Copy-Item .example.env .env (PowerShell)
#   2. '.env' dosyasını projenizin ihtiyaçlarına göre düzenleyin.
#   3. UYARI: '.env' dosyası hassas veriler içerdiği için asla Git'e eklenmemelidir (.gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Veritabanı Yapılandırması (alumni-db)
# ------------------------------------------------------------------------------
POSTGRES_DB=alumnidb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. ASP.NET Core API Yapılandırması (alumni-api)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5273

# ------------------------------------------------------------------------------
# 3. Veritabanı Bağlantı Dizesi (Connection Strings)
# ------------------------------------------------------------------------------
# Docker Compose ortamı için (Konteyner içi ağ üzerinden erişim):
DB_HOST=alumni-db
DB_PORT=5432
# CONNECTION_STRING_DOCKER=Host=alumni-db;Port=5432;Database=alumnidb;Username=postgres;Password=your_secure_password_here;

# Yerel geliştirme ortamı için (dotnet run ile localhost üzerinden erişim):
# CONNECTION_STRING_LOCAL=Host=localhost;Port=5432;Database=alumnidb;Username=postgres;Password=your_secure_password_here;
